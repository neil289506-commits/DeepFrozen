{
	"schemaVersion": 1,
	"id": "deepfrozen",
	"version": "${version}",
	"name": "DeepFrozen",
	"description": "Backports Minecraft 26.4 content (Ice Caves, Packed Ice Bricks, Snow Bricks, Calcite, Frostbite and more) to 26.2.",
	"authors": [
		"neil289506-commits"
	],
	"contact": {
		"homepage": "https://github.com/neil289506-commits/IceWinter",
		"sources": "https://github.com/neil289506-commits/IceWinter"
	},
	"license": "CC0-1.0",
	"icon": "assets/deepfrozen/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"backport.org.DeepFrozen"
		],
		"client": [
			"backport.org.client.DeepFrozenClient"
		]
	},
	"mixins": [
		"deepfrozen.mixins.json",
		{
			"config": "deepfrozen.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
